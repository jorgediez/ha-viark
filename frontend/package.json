{
  "name": "ha-viark-remote-card",
  "version": "1.4.0",
  "description": "A Home Assistant Lovelace card that mimics the Viark satellite receiver remote control.",
  "private": true,
  "type": "module",
  "main": "../custom_components/viark/www/viark-remote-card.js",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "demo": "node scripts/serve-demo.mjs"
  },
  "keywords": [
    "home-assistant",
    "hacs",
    "lovelace",
    "custom-card",
    "viark",
    "remote"
  ],
  "author": "jorgediez",
  "license": "MIT",
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-lit": "^2.3.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "prettier": "^3.9.10",
    "rollup": "^4.64.9",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.3"
  },
  "homepage": "https://github.com/jorgediez/ha-viark#remote-card",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jorgediez/ha-viark.git",
    "directory": "frontend"
  },
  "bugs": {
    "url": "https://github.com/jorgediez/ha-viark/issues"
  }
}
